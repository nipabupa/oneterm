// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // 全局配置
  {
    "context": "Workspace",
    "bindings": {
      "enter": "menu::Confirm",
      "ctrl-s": "workspace::Save",
      "escape": "menu::Cancel",
      "ctrl-c": "menu::Cancel",
      "ctrl-z": "menu::Cancel",
      "ctrl-;": "menu::Cancel",
      "ctrl-,": "zed::OpenSettingsFile",
      "ctrl-tab": "tab_switcher::Toggle",
      "ctrl-shift-p": "projects::OpenRecent",
      "ctrl-shift-o": "workspace::CloseAllDocks",
      "ctrl-shift-b": "workspace::ToggleLeftDock",
      "ctrl-shift-n": "workspace::ToggleBottomDock",
      "ctrl-shift-m": "workspace::ToggleRightDock",
      "ctrl-shift-h": "workspace::ActivatePaneLeft",
      "ctrl-shift-j": "workspace::ActivatePaneDown",
      "ctrl-shift-k": "workspace::ActivatePaneUp",
      "ctrl-shift-l": "workspace::ActivatePaneRight",
      "f3": "debugger::ClearAllBreakpoints",
      "f5": "debugger::Start",
      "f6": "debugger::Continue",
      "f7": "debugger::Restart",
      "f8": "debugger::Stop",
      "f9": "debugger::StepOver",
      "f10": "debugger::StepInto",
      "f11": "debugger::StepOut",
      "f12": "debugger::RunToCursor",
    },
  },
  // menu
  {
    "context": "Picker || Menu",
    "bindings": {
      "enter": "menu::Confirm",
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
    },
  },
  // pane
  {
    "context": "Pane",
    "bindings": {
      "alt-r": "search::ToggleReplace",
      "alt-c": "search::ToggleCaseSensitive",
      "alt-w": "search::ToggleWholeWord",
      "alt-h": "search::ToggleRegex",
      "alt-j": "search::SelectNextMatch",
      "alt-k": "search::SelectPreviousMatch",
      "alt-f": "search::FocusSearch",
      "alt-i": "project_search::ToggleFilters",
      "ctrl-q": "pane::CloseActiveItem",
      "ctrl-w ctrl-a": "pane::CloseAllItems",
      "ctrl-w ctrl-o": "pane::CloseOtherItems",
      "ctrl-w ctrl-l": "pane::CloseItemsToTheLeft",
      "ctrl-w ctrl-h": "pane::CloseItemsToTheRight",
      "ctrl-w ctrl-f": "pane::RevealInProjectPanel",
      "ctrl-w ctrl-j": "pane::SplitVertical",
      "ctrl-w ctrl-k": "pane::SplitHorizontal",
      "ctrl-shift-f": "pane::DeploySearch",
      "ctrl-w >": "vim::ResizePaneRight",
      "ctrl-w <": "vim::ResizePaneLeft",
      "ctrl-w -": "vim::ResizePaneDown",
      "ctrl-w +": "vim::ResizePaneUp",
      "ctrl-w _": "vim::MaximizePane",
      "ctrl-w =": "vim::ResetPaneSizes",
    },
  },
  // 功能模块
  {
    "context": "(!Editor && !Terminal) || (Editor && vim_mode == normal)",
    "bindings": {
      "space f": "file_finder::Toggle",
      ":": "command_palette::Toggle",
      "space n": "project_panel::ToggleFocus",
      "space d": "debug_panel::ToggleFocus",
      "space g": "git_panel::ToggleFocus",
      "space space": "editor::ToggleFocus",
      "space p": "git_panel::ToggleFocus",
      "space q": "diagnostics::Deploy",
      "ctrl-`": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == insert || vim_mode == visual",
    "bindings": {
      "ctrl-a": "vim::StartOfLine",
      "ctrl-e": "vim::EndOfLine",
      "ctrl-/": "vim::ToggleComments",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "i": ["vim::PushObject", { "around": false }],
      "a": ["vim::PushObject", { "around": true }],
      "left": "vim::Left",
      "h": "vim::Left",
      "backspace": "vim::WrappingLeft",
      "down": "vim::Down",
      "j": "vim::Down",
      "up": "vim::Up",
      "k": "vim::Up",
      "right": "vim::Right",
      "l": "vim::Right",
      "escape": "vim::SwitchToNormalMode",
      "ctrl-;": "vim::SwitchToNormalMode",
      "ctrl-c": "vim::SwitchToNormalMode",
      "ctrl-z": "vim::SwitchToNormalMode",
      "0": "vim::StartOfLine",
      "home": "vim::StartOfLine",
      "1": ["vim::Number", 1],
      "2": ["vim::Number", 2],
      "3": ["vim::Number", 3],
      "4": ["vim::Number", 4],
      "5": ["vim::Number", 5],
      "6": ["vim::Number", 6],
      "7": ["vim::Number", 7],
      "8": ["vim::Number", 8],
      "9": ["vim::Number", 9],
      "end": "vim::EndOfLine",
      "$": "vim::EndOfLine",
      "^": "vim::FirstNonWhitespace",
      "*": "vim::MoveToNext",
      "#": "vim::MoveToPrevious",
      ";": "vim::RepeatFind",
      ",": "vim::RepeatFindReversed",
      "{": "vim::StartOfParagraph",
      "}": "vim::EndOfParagraph",
      "(": "vim::SentenceBackward",
      ")": "vim::SentenceForward",
      "f": ["vim::PushFindForward", { "before": false, "multiline": false }],
      "t": ["vim::PushFindForward", { "before": true, "multiline": false }],
      "shift-f": ["vim::PushFindBackward", { "after": false, "multiline": false }],
      "shift-t": ["vim::PushFindBackward", { "after": true, "multiline": false }],
      "m": "vim::PushMark",
      "ctrl-f": "vim::PageDown",
      "ctrl-b": "vim::PageUp",
      "ctrl-u": "vim::ScrollUp",
      "ctrl-d": "vim::ScrollDown",
      "ctrl-t": "vim::LineDown",
      "ctrl-y": "vim::LineUp",
      "pagedown": "vim::PageDown",
      "pageup": "vim::PageUp",
      "w": "vim::NextWordStart",
      "b": "vim::PreviousWordStart",
      "e": "vim::NextWordEnd",
      "shift-w": ["vim::NextWordStart", { "ignore_punctuation": true }],
      "shift-e": ["vim::NextWordEnd", { "ignore_punctuation": true }],
      "shift-b": ["vim::PreviousWordStart", { "ignore_punctuation": true }],
      "n": "vim::MoveToNextMatch",
      "N": "vim::MoveToPreviousMatch",
      "v": "vim::ToggleVisual",
      "V": "vim::ToggleVisualLine",
      "ctrl-v": "vim::ToggleVisualBlock",
      "u": "vim::Undo",
      "U": "vim::Redo",
      "z": "editor::ToggleFold",
      "Z": "editor::FoldAll",
      "/": "vim::Search",
      "?": ["vim::Search", { "backwards": true }],
      ".": "vim::Repeat",
      "shift-k": "editor::Hover",
      "ctrl-o": "pane::GoBack",
      "ctrl-i": "pane::GoForward",
      "g g": "vim::StartOfDocument",
      "G": "vim::EndOfDocument",
      "tab": "pane::ActivateNextItem",
      "shift-tab": "pane::ActivatePreviousItem",
      "q": "editor::ToggleFold",
      "Q": "editor::ToggleFoldAll",
      "z z": "editor::ScrollCursorCenter",
      "z n": "editor::ScrollCursorBottom",
      "z m": "editor::ScrollCursorTop",
      "ctrl-=": "vim::Increment",
      "ctrl--": "vim::Decrement",
    },
  },
  {
    "context": "VimControl && VimCount",
    "bindings": {
      "0": ["vim::Number", 0],
      ":": "vim::CountCommand",
      "%": "vim::GoToPercentage"
    }
  },
  // vim operation
  {
    "context": "vim_operator == i || vim_operator == a || vim_operator == d || vim_operator == y || vim_operator == c || vim_operator == cs || vim_operator == ys",
    "bindings": {
      "escape": "vim::ClearOperators",
      "ctrl-c": "vim::ClearOperators",
      "ctrl-z": "vim::ClearOperators",
      "ctrl-;": "vim::ClearOperators",
      "w": "vim::Word",
      "shift-w": ["vim::Word", { "ignore_punctuation": true }],
      "n": "vim::MiniQuotes",
      "m": "vim::MiniBrackets",
      "\"": "vim::DoubleQuotes",
      "'": "vim::Quotes",
      "[": ["vim::SquareBrackets", { "opening": true }],
      "]": "vim::SquareBrackets",
      "{": ["vim::CurlyBrackets", { "opening": true }],
      "}": "vim::CurlyBrackets",
      "(": ["vim::Parentheses", { "opening": true }],
      ")": "vim::Parentheses",
      "<": ["vim::AngleBrackets", { "opening": true }],
      ">": "vim::AngleBrackets",
      "f": "vim::Method",
      "c": "vim::Class",
      "e": "vim::EntireFile"
    },
  },
  {
    "context": "vim_operator == c",
    "bindings": {
      "c": "vim::CurrentLine",
      "s": ["vim::PushChangeSurrounds", {}]
    }
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "d": "vim::CurrentLine",
      "s": "vim::PushDeleteSurrounds",
    }
  },
  {
    "context": "vim_operator == y",
    "bindings": {
      "y": "vim::CurrentLine",
      "s": ["vim::PushAddSurrounds", {}]
    }
  },
  {
    "context": "vim_operator == >",
    "bindings": {
      ">": "vim::CurrentLine",
    }
  },
  {
    "context": "vim_operator == <",
    "bindings": {
      "<": "vim::CurrentLine",
    }
  },
  // vim normal
  {
    "context": "vim_mode == normal",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
      "a": "vim::InsertAfter",
      "shift-a": "vim::InsertEndOfLine",
      "i": "vim::InsertBefore",
      "shift-i": "vim::InsertFirstNonWhitespace",
      "o": "vim::InsertLineBelow",
      "shift-o": "vim::InsertLineAbove",
      "d": "vim::PushDelete",
      "shift-d": "vim::DeleteToEndOfLine",
      "c": "vim::PushChange",
      "shift-c": "vim::ChangeToEndOfLine",
      "r": "vim::PushReplace",
      "y": "vim::PushYank",
      "shift-y": "vim::YankLine",
      "x": "vim::DeleteRight",
      "shift-x": "vim::DeleteLeft",
      "p": "vim::Paste",
      "shift-p": ["vim::Paste", { "before": true }],
      "shift-j": "vim::JoinLines",
      ">": "vim::PushIndent",
      "<": "vim::PushOutdent",
      "=": "vim::PushAutoIndent",
      "~": "vim::ChangeCase",
      "ctrl-=": "vim::Increment",
      "ctrl--": "vim::Decrement",
      "f4": "editor::ToggleBreakpoint",
      "ctrl-]": "editor::GoToDefinition",
      "ctrl-shift-]": "editor::GoToDeclaration",
      "ctrl-[": "editor::GoToImplementation",
      "ctrl-shift-[": "editor::FindAllReferences",
      "space s": "outline::Toggle",
      "space w": "diagnostics::DeployCurrentFile",
      "space e": "editor::GoToDiagnostic",
      "g j": "pane::GoToNewerTag",
      "g k": "pane::GoToOlderTag",
    },
  },
  // vim insert asd
  {
    "context": "vim_mode == insert",
    "bindings": {
      "escape": "vim::NormalBefore",
      "ctrl-;": "vim::NormalBefore",
      "ctrl-c": "vim::NormalBefore",
      "ctrl-z": "vim::NormalBefore",
      "ctrl-shift-v": "editor::Paste",
      "ctrl-h": "vim::Left",
      "ctrl-j": "vim::Down",
      "ctrl-k": "vim::Up",
      "ctrl-l": "vim::Right",
      "enter": "editor::Newline",
      "backspace": "editor::Backspace",
      "tab": "editor::Tab",
      "shift-tab": "editor::Backtab",
      "ctrl-x ctrl-p": "editor::ShowCompletions",
      "ctrl-x ctrl-c": "editor::ToggleCodeActions",
      "ctrl-x ctrl-z": "editor::Cancel",
      "ctrl-w": ["editor::DeleteToPreviousWordStart", { "ignore_newlines": false, "ignore_brackets": false }],
      "ctrl-u": "editor::DeleteToBeginningOfLine",
    },
  },
  {
    "context": "vim_mode == insert && !(showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-p": "editor::ShowWordCompletions",
      "ctrl-i": "editor::ShowSignatureHelp",
    }
  },
  {
    "context": "(vim_mode == insert || vim_mode == normal) && showing_signature_help && !showing_completions",
    "bindings": {
      "ctrl-j": "editor::SignatureHelpPrevious",
      "ctrl-k": "editor::SignatureHelpNext"
    }
  },
  {
    "context": "vim_mode == replace",
    "bindings": {
      "escape": "vim::NormalBefore",
      "ctrl-;": "vim::NormalBefore",
      "ctrl-c": "vim::NormalBefore",
      "ctrl-z": "vim::NormalBefore",
      "ctrl-shift-v": "editor::Paste",
      "backspace": "vim::UndoReplace",
      "tab": "vim::Tab",
      "enter": "vim::Enter",
      "insert": "vim::InsertBefore"
    }
  },
  {
    "context": "vim_mode == waiting",
    "bindings": {
      "tab": "vim::Tab",
      "enter": "vim::Enter",
      "escape": "vim::ClearOperators",
      "ctrl-c": "vim::ClearOperators",
      "ctrl-z": "vim::ClearOperators",
      "ctrl-;": "vim::ClearOperators",
    }
  },
  // vim visual
  {
    "context": "vim_mode == visual",
    "bindings": {
      ":": "vim::VisualCommand",
      "u": "vim::ConvertToLowerCase",
      "shift-u": "vim::ConvertToUpperCase",
      "y": "vim::VisualYank",
      "shift-y": "vim::VisualYankLine",
      "d": "vim::VisualDelete",
      "shift-d": "vim::VisualDeleteLine",
      "x": "vim::VisualDelete",
      "shift-x": "vim::VisualDeleteLine",
      "delete": "vim::VisualDelete",
      "p": "vim::Paste",
      "shift-p": ["vim::Paste", { "preserve_clipboard": true }],
      "shift-i": "vim::InsertBefore",
      "shift-a": "vim::InsertAfter",
      "shift-j": "vim::JoinLines",
      "~": "vim::ChangeCase",
      "*": ["vim::MoveToNext", { "partial_word": true }],
      "#": ["vim::MoveToPrevious", { "partial_word": true }],
      "ctrl-=": "vim::Increment",
      "ctrl--": "vim::Decrement",
      ">": "vim::Indent",
      "<": "vim::Outdent",
      "=": "vim::AutoIndent",
      "ctrl-shift-c": "editor::Copy",
      "i": ["vim::PushObject", { "around": false }],
      "a": ["vim::PushObject", { "around": true }],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "escape": "editor::Cancel",
      "ctrl-;": "editor::Cancel",
      "ctrl-c": "editor::Cancel",
      "ctrl-z": "editor::Cancel",
    },
  },
  {
    "context": "Editor && mode != full",
    "bindings": {
      "backspace": "editor::Backspace",
      "ctrl-h": "editor::MoveLeft",
      "ctrl-j": "editor::MoveDown",
      "ctrl-k": "editor::MoveUp",
      "ctrl-l": "editor::MoveRight",
      "left": "editor::MoveLeft",
      "down": "editor::MoveDown",
      "up": "editor::MoveUp",
      "right": "editor::MoveRight",
    },
  },
  {
    "context": "Editor && (showing_completions || showing_code_actions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
      "escape": ["action::Sequence", ["editor::Cancel", "vim::NormalBefore"]],
      "ctrl-;": ["action::Sequence", ["editor::Cancel", "vim::NormalBefore"]],
      "ctrl-c": ["action::Sequence", ["editor::Cancel", "vim::NormalBefore"]],
      "ctrl-z": ["action::Sequence", ["editor::Cancel", "vim::NormalBefore"]],
      "ctrl-d": "vim::ScrollDown",
      "ctrl-u": "vim::ScrollUp",
      "ctrl-t": "vim::LineDown",
      "ctrl-y": "vim::LineUp"
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "enter": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "Editor && showing_code_actions",
    "bindings": {
      "enter": "editor::ConfirmCodeAction",
    },
  },
  {
    "context": "multibuffer",
    "bindings": {
      "ctrl-o": "editor::OpenExcerpts",
      "ctrl-n": "editor::ExpandExcerptsDown",
      "ctrl-m": "editor::ExpandExcerptsUp",
    },
  },
  {
    "context": "BufferSearchBar && !in_replace",
    "bindings": {
      "enter": "vim::SearchSubmit",
    },
  },
  {
    "context": "(BufferSearchBar || ProjectSearchBar) && in_replace",
    "bindings": {
      "enter": "search::ReplaceNext",
      "ctrl-enter": "search::ReplaceAll",
    },
  },
  // prject panel
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "j": "vim::MenuSelectNext",
      "k": "vim::MenuSelectPrevious",
      "down": "vim::MenuSelectNext",
      "up": "vim::MenuSelectPrevious",
      "l": "project_panel::ExpandSelectedEntry",
      "h": "project_panel::CollapseSelectedEntry",
      "enter": "project_panel::OpenPermanent",
      "shift-enter": "project_panel::Open",
      "o v": "project_panel::OpenSplitVertical",
      "o h": "project_panel::OpenSplitHorizontal",
      "a f": "project_panel::NewFile",
      "a d": "project_panel::NewDirectory",
      "d": "project_panel::Delete",
      "r": "project_panel::Rename",
      "y y": "project_panel::Copy",
      "y p": "workspace::CopyPath",
      "y r": "workspace::CopyRelativePath",
      "x": "project_panel::Cut",
      "-": "project_panel::SelectParent",
      "p": "project_panel::Paste",
      "q": [
        "action::Sequence",
        ["project_panel::SelectParent", "project_panel::CollapseSelectedEntry"],
      ],
      "}": "project_panel::SelectNextDirectory",
      "{": "project_panel::SelectPrevDirectory",
      "ctrl-d": "project_panel::ScrollDown",
      "ctrl-u": "project_panel::ScrollUp",
      "shift-g": "menu::SelectLast",
      "g g": "menu::SelectFirst",
      "z z": "project_panel::ScrollCursorCenter",
      "z n": "project_panel::ScrollCursorBottom",
      "z m": "project_panel::ScrollCursorTop",
      "1": ["vim::Number", 1],
      "2": ["vim::Number", 2],
      "3": ["vim::Number", 3],
      "4": ["vim::Number", 4],
      "5": ["vim::Number", 5],
      "6": ["vim::Number", 6],
      "7": ["vim::Number", 7],
      "8": ["vim::Number", 8],
      "9": ["vim::Number", 9]
    },
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "shift-g": "menu::SelectLast",
      "g g": "menu::SelectFirst"
    }
  },
  {
    "context": "GitPanel && ChangesList",
    "use_key_equivalents": true,
    "bindings": {
      "k": "menu::SelectPrevious",
      "j": "menu::SelectNext",
      "g g": "menu::SelectFirst",
      "shift-g": "menu::SelectLast",
      "g f": "menu::Confirm",
      "i": "git_panel::FocusEditor",
      "x": "git::ToggleStaged",
      "shift-x": "git::StageAll",
      "g x": "git::StageRange",
      "shift-u": "git::UnstageAll"
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-h": "editor::Backspace",
      "ctrl-u": "editor::DeleteToBeginningOfLine",
      "ctrl-w": "editor::DeleteToPreviousWordStart",
    }
  },
]

